# IMA Copilot MCP 服务器配置文件
# 复制为 .env 后，调用 login 工具即可自动填充认证信息

# ==============================
# 🔴 认证信息（由 login 工具自动填充，无需手动配置）
# ==============================

# 以下两项会在调用 login 工具后自动写入
# 如果你已有认证信息，也可以手动填入
IMA_X_IMA_COOKIE=""
IMA_X_IMA_BKN=""

# ==============================
# 🟡 知识库配置（首次使用需手动配置）
# ==============================

# 知识库 ID（必填：至少配置一个）
# 登录 IMA 后，在知识库页面的 URL 中可以找到 ID
# 单知识库模式：
IMA_KNOWLEDGE_BASE_ID=7305806844290061

# 多知识库模式（逗号分隔）：
# IMA_KNOWLEDGE_BASE_IDS=7305806844290061,7305806844290062

# ==============================
# ⚙️ 可选配置（通常无需修改）
# ==============================

# [服务器地址]
# IMA_MCP_HOST=127.0.0.1

# [服务器端口]
# IMA_MCP_PORT=8081

# [日志级别] (DEBUG, INFO, WARNING, ERROR)
# IMA_MCP_LOG_LEVEL=INFO

# [请求超时] (秒)
# IMA_REQUEST_TIMEOUT=30

# [基础重试次数] (网络/超时类异常)
# IMA_RETRY_COUNT=3

# [问答并发上限] 建议 1-2，默认 1
# IMA_ASK_CONCURRENCY_LIMIT=1

# [代理设置] (例如: http://127.0.0.1:7890)
# IMA_PROXY=

# [高级参数] (通常无需修改)
# IMA_ROBOT_TYPE=5
# IMA_SCENE_TYPE=1
# IMA_MODEL_TYPE=4
